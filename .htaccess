# Ellipse Hotels — Apache document root helpers
# Place this file in the same folder as index.html (usually public_html)

DirectoryIndex index.html index.htm

# Stop Apache from showing a bare folder listing when index fails
Options -Indexes

# If someone hits a directory URL, try index.html first
<IfModule mod_dir.c>
  DirectoryIndex index.html
</IfModule>

# Helpful when assets 404 after deploy
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Do not rewrite real files/folders
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
</IfModule>

# Reduce stale-page pain during staging / frequent updates
# HTML must always revalidate; CSS/JS revalidate quickly
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
